    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "## ML lifecycle\n[Live pipeline console](http://localhost:8081/) \u00b7 [MLflow runs & registry](http://localhost:5000/) \u00b7 [Service operations](http://localhost:13000/d/local-math-assistant)\n\nLast recorded stage outcomes and durations. The generation score covers **five declared cases** and does not estimate broad mathematical accuracy."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed stages",
      "description": "Expected: 11 selected-model stages.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(math_pipeline_stage_success == bool 1)",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
