  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(math_assistant_requests_total[5m])) by (endpoint, outcome)", "legendFormat": "{{endpoint}} / {{outcome}}", "refId": "A"}],
      "title": "Request throughput by endpoint and outcome",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(math_assistant_request_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "p95 {{endpoint}}", "refId": "A"}],
      "title": "p95 API latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [{"expr": "sum(increase(math_assistant_requests_total{outcome=\"error\"}[1h])) + sum(increase(math_assistant_requests_total{outcome=\"unavailable\"}[1h]))", "legendFormat": "failed or unavailable requests", "refId": "A"}],
      "title": "Errors and unavailable requests (last hour)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [{"expr": "sum(increase(math_assistant_requests_total{endpoint=\"solve\",outcome=\"ok\"}[1h]))", "legendFormat": "successful solves", "refId": "A"}],
      "title": "Successful solves (last hour)",
      "type": "stat"
    }
  ],
