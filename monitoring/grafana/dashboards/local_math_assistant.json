      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "## Service operations\nLocal CPU inference \u00b7 15-second telemetry \u00b7 [Incident response](http://localhost:13000/d/math-alert-center) \u00b7 [Pipeline evidence](http://localhost:13000/d/math-mlops)\n\nMetrics availability and HTTP readiness are separate signals. No-traffic latency is intentionally shown as **No data**."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Metrics up",
      "description": "Expected: 7 scrape targets. HTTP readiness is shown below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job!=\"http-probes\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
